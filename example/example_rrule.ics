BEGIN:VEVENT
UID:weekly-event-001@example.com
DTSTAMP:20260101T120000Z
DTSTART:20260101T090000
DTEND:20260101T100000
SUMMARY:Weekly Standup Meeting
DESCRIPTION:A recurring weekly event
RRULE:FREQ=WEEKLY
EXDATE:20260416T090000
END:VEVENT
BEGIN:VEVENT
UID:weekly-event-001@example.com
DTSTAMP:20260101T120000Z
RECURRENCE-ID:20260409T090000
DTSTART:20260410T090000
DTEND:20260410T100000
SUMMARY:Weekly Standup Meeting (moved)
DESCRIPTION:Rescheduled instance of the weekly standup
END:VEVENT
BEGIN:VEVENT
UID:biweekly-review-001@example.com
DTSTAMP:20260101T120000Z
DTSTART;VALUE=DATE:20260106
SUMMARY:Biweekly Review
DESCRIPTION:Every other Tuesday for 10 occurrences (INTERVAL + COUNT)
RRULE:FREQ=WEEKLY;INTERVAL=2;COUNT=10
END:VEVENT
BEGIN:VEVENT
UID:payday-31st-001@example.com
DTSTAMP:20260101T120000Z
DTSTART;VALUE=DATE:20260131
SUMMARY:Payday (31st)
DESCRIPTION:Monthly on the 31st; months without a 31st are skipped
RRULE:FREQ=MONTHLY
END:VEVENT
BEGIN:VEVENT
UID:month-end-001@example.com
DTSTAMP:20260101T120000Z
DTSTART;VALUE=DATE:20260131
SUMMARY:Month End Close
DESCRIPTION:Last day of every month (negative BYMONTHDAY)
RRULE:FREQ=MONTHLY;BYMONTHDAY=-1
END:VEVENT
BEGIN:VEVENT
UID:first-monday-001@example.com
DTSTAMP:20260101T120000Z
DTSTART;VALUE=DATE:20260105
SUMMARY:First Monday Planning
DESCRIPTION:First Monday of each month (ordinal BYDAY)
RRULE:FREQ=MONTHLY;BYDAY=1MO
END:VEVENT
BEGIN:VEVENT
UID:last-friday-001@example.com
DTSTAMP:20260101T120000Z
DTSTART;VALUE=DATE:20260130
SUMMARY:Last Friday Demo
DESCRIPTION:Last Friday of each month through June (BYDAY + UNTIL)
RRULE:FREQ=MONTHLY;BYDAY=-1FR;UNTIL=20260630
END:VEVENT
BEGIN:VEVENT
UID:tue-thu-gym-001@example.com
DTSTAMP:20260101T120000Z
DTSTART:20260203T180000
DTEND:20260203T190000
SUMMARY:Gym
DESCRIPTION:Tuesdays and Thursdays in February and March (BYDAY + BYMONTH)
RRULE:FREQ=WEEKLY;BYDAY=TU,TH;BYMONTH=2,3
END:VEVENT
BEGIN:VEVENT
UID:anniversary-001@example.com
DTSTAMP:20260101T120000Z
DTSTART;VALUE=DATE:20200915
SUMMARY:Work Anniversary
DESCRIPTION:Yearly; month and day derived from DTSTART
RRULE:FREQ=YEARLY
END:VEVENT
BEGIN:VEVENT
UID:leap-day-001@example.com
DTSTAMP:20260101T120000Z
DTSTART;VALUE=DATE:20240229
SUMMARY:Leap Day Party
DESCRIPTION:Yearly on Feb 29; only appears in leap years
RRULE:FREQ=YEARLY
END:VEVENT
BEGIN:VEVENT
UID:offsite-duration-001@example.com
DTSTAMP:20260101T120000Z
DTSTART;VALUE=DATE:20260511
DURATION:P3D
SUMMARY:Team Offsite
DESCRIPTION:Multi-day event specified with DURATION instead of DTEND
END:VEVENT
